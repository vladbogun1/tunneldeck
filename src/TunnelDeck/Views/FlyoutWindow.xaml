<Window x:Class="TunnelDeck.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TunnelDeck.Views"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Width="404" Height="644" TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <v:BoolToVisibilityConverter x:Key="BoolVis"/>
        <v:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True"/>
        <v:EnumMatchToVisibilityConverter x:Key="EnumVis"/>
        <v:EmojiStripConverter x:Key="StripEmoji"/>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBg}" CornerRadius="10" BorderBrush="{DynamicResource Stroke}"
            BorderThickness="1" Margin="12" TextElement.Foreground="{DynamicResource TextPrimary}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="3" Opacity="0.22" Color="Black"/>
        </Border.Effect>

        <Grid>
            <!-- ============================ MAIN ============================ -->
            <Grid Margin="18" Visibility="{Binding CurrentPage, Converter={StaticResource EnumVis}, ConverterParameter=Main}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="11" Height="11" Fill="{Binding StatusBrush}"/>
                        <TextBlock Text="TunnelDeck" FontSize="17" FontWeight="Bold" Margin="9,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Content="⚙"
                                FontSize="16" ToolTip="{DynamicResource S.TipSettings}" Command="{Binding GoSettingsCommand}"/>
                        <Button Style="{StaticResource IconButton}" Content="✕" FontSize="12"
                                ToolTip="{DynamicResource S.TipMinimize}" Click="Minimize_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Connect card -->
                <Border Grid.Row="1" Background="{DynamicResource Card}" CornerRadius="8" Padding="16"
                        Margin="0,14,0,0" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                    <StackPanel>
                        <!-- Update banner -->
                        <Border Background="{DynamicResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                CornerRadius="7" Padding="10,8" Margin="0,0,0,12"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding UpdateVersionText}" FontSize="12.5" FontWeight="SemiBold"/>
                                    <Button Style="{StaticResource LinkButton}" Content="{DynamicResource S.WhatsNew}"
                                            HorizontalAlignment="Left" Padding="0" Margin="0,1,0,0" FontSize="11"
                                            Command="{Binding OpenReleaseNotesCommand}"
                                            Visibility="{Binding UpdateStatus, Converter={StaticResource BoolVisInv}}"/>
                                    <TextBlock Text="{Binding UpdateStatus}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding UpdateStatus, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource S.Update}" Style="{StaticResource PrimaryButton}"
                                        Height="30" Padding="14,0" VerticalAlignment="Center"
                                        Command="{Binding UpdateNowCommand}"/>
                            </Grid>
                        </Border>

                        <!-- Leak / tunnel-down warning -->
                        <Border Background="{StaticResource RedSoft}" BorderBrush="{StaticResource Red}" BorderThickness="1"
                                CornerRadius="7" Padding="10,8" Margin="0,0,0,12"
                                Visibility="{Binding LeakWarning, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" FontSize="15" Foreground="{StaticResource Red}"
                                           VerticalAlignment="Top" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding LeakWarningText}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Red}"/>
                                    <TextBlock Text="{Binding LeakWarningSub}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="#8A1E14"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="·" FontSize="14" Margin="7,0,7,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Visibility="{Binding ShowDuration, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="{Binding SessionDurationText}" FontSize="13" VerticalAlignment="Center"
                                       FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource TextSecondary}"
                                       Visibility="{Binding ShowDuration, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Visibility="{Binding StatusDetail, Converter={StaticResource BoolVis}}"/>

                        <!-- Throughput (live) + cumulative session totals, one compact row -->
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                    Visibility="{Binding ShowSpeed, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="↓" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Green}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalDownText}" FontSize="12" Margin="4,0,12,0"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock Text="↑" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalUpText}" FontSize="12" Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock Text="·" FontSize="12" Margin="10,0,10,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiary}"/>
                            <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}"
                                       ToolTip="{DynamicResource S.Session}">
                                <Run Text="{Binding SessionDownText, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding SessionUpText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <ComboBox x:Name="ServerBox" Margin="0,14,0,0"
                                  Visibility="{Binding HasSubscription, Converter={StaticResource BoolVis}}"
                                  ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServerItem}"
                                  DropDownOpened="ServerBox_DropDownOpened">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="22" Height="14" CornerRadius="2" Margin="0,0,9,0"
                                                VerticalAlignment="Center" BorderBrush="{DynamicResource Stroke}" BorderThickness="0.6"
                                                Visibility="{Binding HasFlag, Converter={StaticResource BoolVis}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding FlagImage}" Stretch="Fill"/>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Margin="10,0,0,0" CornerRadius="9" Padding="7,1"
                                                VerticalAlignment="Center" Background="{Binding PingBrush}"
                                                Visibility="{Binding HasPing, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding PingText}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Content="{Binding ConnectLabel}" Style="{StaticResource ConnectButton}"
                                Background="{Binding ConnectButtonBrush}"
                                Command="{Binding ToggleConnectionCommand}" Margin="0,10,0,0"
                                IsEnabled="{Binding HasSubscription}"
                                Visibility="{Binding HasSubscription, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Apps section header -->
                <TextBlock Grid.Row="2" Text="{DynamicResource S.AppsHeader}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextTertiary}" Margin="2,20,0,8"
                           Visibility="{Binding HasSubscription, Converter={StaticResource BoolVis}}"/>

                <!-- Apps list -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSubscription, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding TunneledApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Card}" CornerRadius="8" Padding="12,10"
                                            Margin="0,0,0,8" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{Binding Icon}" Width="28" Height="28"
                                                   VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProcessName}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="2" Style="{StaticResource Switch}"
                                                          IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="✕"
                                                    Width="30" Height="30" FontSize="12" Margin="4,0,0,0"
                                                    ToolTip="{DynamicResource S.TipRemove}"
                                                    Command="{Binding DataContext.RemoveAppCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Sites -->
                        <TextBlock Text="{DynamicResource S.SitesHeader}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiary}" Margin="2,12,0,8"
                                   Visibility="{Binding HasSites, Converter={StaticResource BoolVis}}"/>
                        <ItemsControl ItemsSource="{Binding TunneledSites}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Card}" CornerRadius="8" Padding="12,10"
                                            Margin="0,0,0,8" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE774;"
                                                       FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Domain}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{DynamicResource S.ViaBrowser}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="✕"
                                                    Width="30" Height="30" FontSize="12" ToolTip="{DynamicResource S.TipRemove}"
                                                    Command="{Binding DataContext.RemoveSiteCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{DynamicResource CardAlt}" CornerRadius="8" Padding="16" Margin="0,2,0,0"
                                BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                Visibility="{Binding NothingTunneled, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.EmptyTitle}" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{DynamicResource S.EmptySub}"
                                           FontSize="11.5" Foreground="{DynamicResource TextTertiary}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Onboarding (no subscription) -->
                <Border Grid.Row="3" Background="{DynamicResource Card}" CornerRadius="8" Padding="20"
                        Margin="0,14,0,0" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                        VerticalAlignment="Top"
                        Visibility="{Binding HasSubscription, Converter={StaticResource BoolVisInv}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.OnboardTitle}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource S.OnboardSub}"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap"
                                   Margin="0,6,0,14"/>
                        <Button Content="{DynamicResource S.PasteKey}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding GoSubscriptionCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Add button -->
                <Button Grid.Row="4" Content="{DynamicResource S.AddApp}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding GoAddAppCommand}" Margin="0,10,0,0"
                        Visibility="{Binding HasSubscription, Converter={StaticResource BoolVis}}"/>

                <!-- Footer -->
                <Grid Grid.Row="5" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource ChipButton}" HorizontalAlignment="Stretch"
                            Content="{DynamicResource S.RefreshKey}" Command="{Binding GoSubscriptionCommand}"
                            Visibility="{Binding HasSubscription, Converter={StaticResource BoolVis}}"/>
                    <Button Grid.Column="1" Style="{StaticResource ChipButton}" HorizontalAlignment="Stretch"
                            Margin="8,0,0,0" Content="{DynamicResource S.Connections}" Command="{Binding GoConnectionsCommand}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolVis}}"/>

                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding CoreVersion}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="10.5" Foreground="{DynamicResource TextTertiary}"
                               Visibility="{Binding IsConnected, Converter={StaticResource BoolVisInv}}"/>
                </Grid>
            </Grid>

            <!-- ============================ ADD APP ============================ -->
            <Grid Margin="18" Visibility="{Binding CurrentPage, Converter={StaticResource EnumVis}, ConverterParameter=AddApp}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="←" FontSize="17"
                            Command="{Binding GoBackCommand}"/>
                    <TextBlock Text="{DynamicResource S.AddAppTitle}" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Input}"
                             HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                             Text="{Binding AddApp.Search, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{DynamicResource S.SearchApp}" IsHitTestVisible="False" VerticalAlignment="Center"
                               HorizontalAlignment="Left" Margin="13,0,0,0" FontSize="13"
                               Foreground="{DynamicResource TextTertiary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/>
                                            <Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding AddApp.IsLoading, Converter={StaticResource BoolVis}}">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4" Foreground="{StaticResource Accent}"
                                 Background="{DynamicResource Stroke}" BorderThickness="0"/>
                    <TextBlock Text="{DynamicResource S.LoadingApps}" Margin="0,10,0,0" HorizontalAlignment="Center"
                               FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <ListBox x:Name="RunningList"
                         Visibility="{Binding AddApp.IsLoading, Converter={StaticResource BoolVisInv}}"
                         ItemsSource="{Binding AddApp.Apps}" SelectedItem="{Binding AddApp.Selected, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="RunningList_DoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Background="{DynamicResource Card}" CornerRadius="8"
                                                Padding="11" BorderThickness="1" BorderBrush="{DynamicResource Stroke}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                <Setter TargetName="b" Property="BorderThickness" Value="1.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding Icon}" Width="28" Height="28"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ProcessName}" Foreground="{DynamicResource TextSecondary}"
                                               FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <Button Content="{DynamicResource S.BrowseExe}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseAndAddCommand}"/>
                    <Button Content="{DynamicResource S.AddSelected}" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                            Command="{Binding AddSelectedRunningCommand}"
                            IsEnabled="{Binding AddApp.Selected, Converter={StaticResource BoolVis}}"/>

                    <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,14,0,10"/>
                    <TextBlock Text="{DynamicResource S.SiteHint}"
                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="SiteBox" Style="{StaticResource Input}"
                                     HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                     Text="{Binding AddSiteInput, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="youtube.com" IsHitTestVisible="False" VerticalAlignment="Center"
                                       HorizontalAlignment="Left" Margin="13,0,0,0" FontSize="13"
                                       Foreground="{DynamicResource TextTertiary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=SiteBox}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=SiteBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="1" Content="{DynamicResource S.AddSite}" Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0" Command="{Binding AddSiteCommand}"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ============================ SETTINGS ============================ -->
            <Grid Margin="18" Visibility="{Binding CurrentPage, Converter={StaticResource EnumVis}, ConverterParameter=Settings}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="←" FontSize="17"
                            Command="{Binding GoBackCommand}"/>
                    <TextBlock Text="{DynamicResource S.SettingsTitle}" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <Border Background="{DynamicResource Card}" CornerRadius="8" BorderBrush="{DynamicResource Stroke}"
                            BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="14,13">
                                <StackPanel Margin="0,0,54,0">
                                    <TextBlock Text="{DynamicResource S.StartWin}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource S.StartWinSub}" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" IsChecked="{Binding StartWithWindows}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Stroke}"/>
                            <Grid Margin="14,13">
                                <StackPanel Margin="0,0,54,0">
                                    <TextBlock Text="{DynamicResource S.AutoConnect}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource S.AutoConnectSub}" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" IsChecked="{Binding AutoConnectOnLaunch}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Stroke}"/>
                            <Grid Margin="14,13">
                                <StackPanel Margin="0,0,54,0">
                                    <TextBlock Text="Kill-switch" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource S.KillSwitchSub}" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" IsChecked="{Binding KillSwitch}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Stroke}"/>
                            <Grid Margin="14,13">
                                <StackPanel Margin="0,0,54,0">
                                    <TextBlock Text="{DynamicResource S.DnsVpn}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource S.DnsVpnSub}" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" IsChecked="{Binding ProxyDns}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Stroke}"/>
                            <Grid Margin="14,13">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S.LogLevel}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource S.LogLevelSub}" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <ComboBox Width="130" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Stroke}"/>
                            <Grid Margin="14,13">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S.Language}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource S.LanguageSub}" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <ComboBox Width="130" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          SelectedValuePath="Tag" SelectedValue="{Binding Language}">
                                    <ComboBoxItem Content="{DynamicResource S.LangAuto}" Tag="system"/>
                                    <ComboBoxItem Content="Русский" Tag="ru"/>
                                    <ComboBoxItem Content="English" Tag="en"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- ============================ SUBSCRIPTION ============================ -->
            <Grid Margin="18" Visibility="{Binding CurrentPage, Converter={StaticResource EnumVis}, ConverterParameter=Subscription}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="←" FontSize="17"
                            Command="{Binding GoBackCommand}"/>
                    <TextBlock Text="{DynamicResource S.SubTitle}" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Margin="2,14,0,0" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource S.SubDesc}"/>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <TextBox x:Name="SubBox" Style="{StaticResource Input}"
                             Text="{Binding SubscriptionInput, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="https://…  |  vless://…" IsHitTestVisible="False" VerticalAlignment="Top"
                               Margin="13,10,0,0" FontSize="13" Foreground="{DynamicResource TextTertiary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SubBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock Grid.Row="3" Text="{Binding StatusDetail}" Margin="2,10,0,0" TextWrapping="Wrap"
                           FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>

                <Button Grid.Row="4" Content="{DynamicResource S.LoadServers}" Style="{StaticResource PrimaryButton}"
                        Margin="0,12,0,0" Command="{Binding LoadSubscriptionCommand}"/>
            </Grid>

            <!-- ============================ CONNECTIONS ============================ -->
            <Grid Margin="18" Visibility="{Binding CurrentPage, Converter={StaticResource EnumVis}, ConverterParameter=Connections}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="←" FontSize="17"
                            Command="{Binding GoBackCommand}"/>
                    <TextBlock Text="{DynamicResource S.ConnTitle}" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding ActiveConnections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Card}" CornerRadius="8" Padding="12,9"
                                            Margin="0,0,0,7" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Host}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                           Foreground="{DynamicResource TextTertiary}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TrafficText}" FontSize="11"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{DynamicResource CardAlt}" CornerRadius="8" Padding="16" Margin="0,2,0,0"
                                BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                Visibility="{Binding HasConnections, Converter={StaticResource BoolVisInv}}">
                            <TextBlock Text="{DynamicResource S.ConnEmpty}" FontSize="12"
                                       Foreground="{DynamicResource TextTertiary}"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
